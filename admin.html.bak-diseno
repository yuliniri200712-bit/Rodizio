<!DOCTYPE html>
<html lang="es-CO">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
  <title>Rodízio Cúcuta — Panel del restaurante</title>
  <meta name="author" content="ParaTouch — DJG (djgv · Mxi)" />
  <meta name="robots" content="noindex, nofollow" />

  <!-- PWA -->
  <link rel="manifest" href="manifest-admin.json" />
  <meta name="theme-color" content="#2A2D33" />
  <link rel="icon" href="icon.svg" type="image/svg+xml" />
  <link rel="icon" type="image/png" sizes="16x16" href="favicon-16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="css/marca.css" />
  <link rel="stylesheet" href="css/variables.css" />
  <link rel="stylesheet" href="css/base.css" />
  <link rel="stylesheet" href="css/layout.css" />
  <link rel="stylesheet" href="css/components.css" />
  <link rel="stylesheet" href="css/admin.css" />
</head>
<body>

  <!-- ============ SPLASH ============ -->
  <div id="splash" aria-hidden="true">
    <div class="splash-box">
      <img class="splash-logo" src="brand/logo-white.webp" alt="Rodízio Cúcuta" />
      <div class="spark-line"></div>
    </div>
  </div>

  <div class="overlay" id="overlay"></div>

  <div id="fatal-error-banner" class="fatal-error-banner" hidden>
    <img class="brand-mark" src="icon.svg" alt="" width="48" height="48" />
    <h3>Algo salió mal</h3>
    <p>Tuvimos un problema inesperado en el panel. Intenta recargar la página.</p>
    <button type="button" class="btn btn-primary">Recargar</button>
  </div>

  <div id="admin-app">

    <header class="app-header">
      <div class="brand" id="btn-brand-home" role="button" tabindex="0" aria-label="Ir a Pedidos">
        <img class="admin-brand-logo-img" src="brand/logo-white.webp" alt="Rodízio Cúcuta" />
        <span class="brand-name">Panel</span>
      </div>
      <div class="header-actions">
        <button class="btn btn-danger-link" id="btn-admin-signout" hidden>Cerrar sesión</button>
      </div>
    </header>

    <!-- ============ ESTADO: SIN SESIÓN ============ -->
    <section class="admin-gate" id="gate-signed-out">
      <div class="admin-gate-card">
        <img class="admin-gate-logo" src="brand/logo-dark-trans.webp" alt="Rodízio Cúcuta" />
        <h1 class="admin-gate-title">Panel del restaurante</h1>
        <p class="admin-gate-text" id="admin-auth-subtitle">Inicia sesión con tu correo y contraseña de administrador.</p>

        <form id="admin-auth-form">
          <div class="field">
            <label for="admin-email">Correo</label>
            <input id="admin-email" type="email" autocomplete="email" placeholder="tucorreo@ejemplo.com" required />
          </div>
          <div class="field">
            <label for="admin-password">Contraseña</label>
            <input id="admin-password" type="password" autocomplete="current-password" placeholder="Mínimo 6 caracteres" minlength="6" required />
          </div>
          <label class="checkbox-field checkbox-field-consent" id="admin-consent-row" hidden>
            <input type="checkbox" id="admin-consent-checkbox" />
            <span>He leído y acepto la <a href="privacidad.html#panel" target="_blank" rel="noopener noreferrer">política de tratamiento de datos personales</a>.</span>
          </label>
          <button type="submit" class="btn btn-primary" id="btn-admin-auth-submit">Iniciar sesión</button>
        </form>

        <div class="admin-auth-links">
          <button type="button" class="admin-link-btn" id="btn-admin-toggle-mode">¿No tienes cuenta? Regístrate</button>
          <button type="button" class="admin-link-btn" id="btn-admin-forgot">¿Olvidaste tu contraseña?</button>
        </div>
      </div>
    </section>

    <!-- ============ ESTADO: SIN PERMISO ============ -->
    <section class="admin-gate" id="gate-not-admin" hidden>
      <div class="admin-gate-card">
        <div class="admin-gate-icon admin-gate-icon-locked">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 11V8a4 4 0 018 0v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </div>
        <h1 class="admin-gate-title">No tienes acceso</h1>
        <p class="admin-gate-text" id="gate-not-admin-text">
          Esta cuenta inició sesión pero no está autorizada como administradora del panel.
        </p>
        <button class="btn btn-ghost" id="btn-admin-signout-2">Cerrar sesión</button>
      </div>
    </section>

    <!-- ============ PANEL (solo admins) ============ -->
    <main id="admin-main" hidden>
      <nav class="segmented admin-tabs" id="admin-tabs">
        <button type="button" data-tab="pedidos" class="is-active">Pedidos<span class="admin-tab-badge" id="admin-tab-badge-pedidos" hidden>0</span></button>
        <button type="button" data-tab="inventario">Inventario</button>
        <button type="button" data-tab="menu" data-role="dueno">Menú</button>
        <button type="button" data-tab="domiciliarios" data-role="dueno">Domiciliarios</button>
        <button type="button" data-tab="reportes" data-role="dueno">Reportes</button>
        <button type="button" data-tab="config" data-role="dueno">Configuración</button>
      </nav>

      <!-- --- Pedidos --- -->
      <section id="tab-pedidos">
        <div class="admin-quick-stats" id="admin-quick-stats"></div>
        <p class="admin-filter-label">Ver pedidos de:</p>
        <div class="admin-filter-row admin-date-filter" id="admin-date-filter">
          <button type="button" data-date="hoy" class="is-active">Hoy</button>
          <button type="button" data-date="ayer">Ayer</button>
          <button type="button" data-date="todos">Todos los días</button>
          <input type="date" id="admin-date-picker" aria-label="Elegir un día" />
        </div>
        <!-- En celular: pastillas que se deslizan (normal ahí). Desde
             escritorio (ver admin.css, 1080px) esta fila de 10 nombres
             obligaba a buscar entre ellos deslizando de lado — se
             reemplaza por el <select> de abajo, mismo criterio que ya
             se usó para el filtro de categoría en Menú/Inventario. -->
        <p class="admin-filter-label">Filtrar por estado del pedido:</p>
        <div class="admin-filter-row" id="admin-status-filter">
          <button type="button" data-filter="todos">Todos<span class="admin-filter-count" data-count-for="todos"></span></button>
          <button type="button" data-filter="recibido" class="is-active">Recibido<span class="admin-filter-count" data-count-for="recibido"></span></button>
          <button type="button" data-filter="enviado">Confirmado<span class="admin-filter-count" data-count-for="enviado"></span></button>
          <button type="button" data-filter="preparacion">En cocina<span class="admin-filter-count" data-count-for="preparacion"></span></button>
          <button type="button" data-filter="listo">Listo<span class="admin-filter-count" data-count-for="listo"></span></button>
          <button type="button" data-filter="en_camino">En camino<span class="admin-filter-count" data-count-for="en_camino"></span></button>
          <button type="button" data-filter="llegado">Llegando<span class="admin-filter-count" data-count-for="llegado"></span></button>
          <button type="button" data-filter="entregado">Entregado<span class="admin-filter-count" data-count-for="entregado"></span></button>
          <button type="button" data-filter="no_entregado">No entregado<span class="admin-filter-count" data-count-for="no_entregado"></span></button>
          <button type="button" data-filter="programados">Programados<span class="admin-filter-count" data-count-for="programados"></span></button>
          <button type="button" data-filter="cancelado">Cancelado<span class="admin-filter-count" data-count-for="cancelado"></span></button>
        </div>
        <select class="admin-category-select admin-status-select" id="admin-status-select"></select>
        <div class="admin-search-row">
          <input type="search" id="admin-order-search" placeholder="Buscar por nombre o teléfono…" />
        </div>
        <div id="admin-orders-list"></div>
      </section>

      <!-- --- Inventario --- -->
      <section id="tab-inventario" hidden>
        <p class="admin-hint">Cada producto tiene un solo estado: <strong>Disponible</strong> (se puede pedir, con o sin conteo de unidades), <strong>Agotado</strong> (se ve, pero no se puede pedir) u <strong>Oculto</strong> (no sale en la tienda).</p>
        <div class="admin-search-row">
          <input type="search" id="admin-stock-search" placeholder="Buscar producto…" />
        </div>
        <div class="admin-filter-row" id="admin-stock-category-filter"></div>
        <div class="admin-filter-row" id="admin-stock-status-filter"></div>
        <div id="admin-stock-list"></div>
      </section>

      <!-- --- Menú (categorías y productos) --- -->
      <section id="tab-menu" hidden>
        <div class="admin-seed-banner" id="admin-seed-banner" hidden>
          <p>Tu base de datos todavía no tiene menú.</p>
          <button type="button" class="btn btn-primary" id="btn-seed-catalog">Cargar menú inicial</button>
        </div>

        <div class="admin-menu-section">
          <div class="admin-menu-section-head">
            <h3>Categorías</h3>
            <button type="button" class="admin-add-btn" id="btn-add-category">+ Agregar</button>
          </div>
          <div id="admin-categories-list"></div>
        </div>

        <div class="admin-menu-section">
          <div class="admin-menu-section-head">
            <h3>Productos</h3>
            <button type="button" class="admin-add-btn" id="btn-add-product">+ Agregar</button>
          </div>
          <div class="admin-search-row">
            <input type="search" id="admin-product-search" placeholder="Buscar producto…" />
          </div>
          <div class="admin-filter-row" id="admin-products-category-filter"></div>
          <div id="admin-products-list"></div>
        </div>

        <!-- Editar/crear producto: antes era un formulario largo pegado
             al final de la página — había que bajar todo el scroll para
             encontrarlo después de tocar "Editar". Ahora es una ventana
             flotante (mismo patrón .modal/.overlay que ya usa la tienda
             de clientes, ver index.html) que se abre ahí mismo. -->
        <div class="modal" id="product-modal" hidden>
          <div class="drawer-header">
            <h3 id="product-modal-title">Producto</h3>
            <button type="button" class="icon-btn" id="btn-close-product-modal" aria-label="Cerrar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
          </div>
          <form class="admin-form drawer-body" id="product-form">
            <input type="hidden" id="product-form-id" />
            <div class="field">
              <label for="product-form-name">Nombre</label>
              <input id="product-form-name" type="text" placeholder="Ej: Picanha" />
            </div>
            <div class="field">
              <label for="product-form-category">Categoría</label>
              <select id="product-form-category"></select>
            </div>
            <div class="field">
              <label for="product-form-desc">Descripción</label>
              <textarea id="product-form-desc" rows="2" placeholder="Descripción corta para la tarjeta"></textarea>
            </div>
            <div class="field">
              <label for="product-form-price">Precio (COP)</label>
              <input id="product-form-price" type="number" min="0" step="500" placeholder="28000" />
            </div>
            <div class="field">
              <label for="product-form-image">Imagen (ruta o URL)</label>
              <input id="product-form-image" type="text" placeholder="images/nuevo-plato.jpg" />
            </div>
            <div class="field">
              <label for="product-form-badge">Insignia (opcional)</label>
              <input id="product-form-badge" type="text" placeholder="Ej: Nuevo" />
            </div>
            <div class="field">
              <label for="product-form-subgroup">Sub-categoría (opcional)</label>
              <select id="product-form-subgroup">
                <option value="">Ninguna</option>
              </select>
            </div>
            <div class="field">
              <label for="product-form-sabores">Sabores con lista fija (separados por coma, opcional)</label>
              <input id="product-form-sabores" type="text" placeholder="Ej: Mora, Lulo, Mango, Maracuyá" />
            </div>
            <label class="checkbox-field">
              <input type="checkbox" id="product-form-pedir-sabor" />
              <span>El cliente escribe el sabor (sin lista fija) — solo si el campo de arriba está vacío</span>
            </label>
            <div class="admin-form-actions">
              <button type="button" class="btn btn-ghost" id="btn-cancel-product">Cancelar</button>
              <button type="submit" class="btn btn-primary">Guardar producto</button>
            </div>
          </form>
        </div>

        <!-- Detalle de una categoría: sus productos, buscador para sumar
             productos que ya existen y atajo para crear un plato nuevo
             dentro de ella. Mismo patrón .modal/.overlay que "Producto". -->
        <div class="modal" id="category-modal" hidden>
          <div class="drawer-header">
            <h3 id="category-modal-title">Categoría</h3>
            <button type="button" class="icon-btn" id="btn-close-category-modal" aria-label="Cerrar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
          </div>
          <div class="drawer-body admin-category-detail">
            <div class="admin-menu-section-head">
              <h4>Productos <span id="category-modal-count"></span></h4>
              <button type="button" class="admin-add-btn" id="btn-category-new-product">+ Nuevo plato</button>
            </div>
            <div id="category-modal-products"></div>
            <div class="admin-menu-section-head">
              <h4>Agregar un producto que ya existe</h4>
            </div>
            <div class="admin-search-row">
              <input type="search" id="category-modal-search" placeholder="Buscar producto…" />
            </div>
            <div id="category-modal-candidates"></div>
          </div>
        </div>
      </section>

      <!-- --- Domiciliarios --- -->
      <section id="tab-domiciliarios" hidden>
        <div class="admin-menu-section">
          <div class="admin-menu-section-head">
            <h3>Domiciliarios</h3>
            <button type="button" class="admin-add-btn" id="btn-add-driver">+ Agregar</button>
          </div>
          <p class="admin-hint">Crea aquí la cuenta del domiciliario — queda habilitado de una vez, ya puede entrar a su app con el correo y contraseña que le pongas.</p>

          <div class="admin-search-row">
            <input type="search" id="admin-drivers-search" placeholder="Buscar por nombre o teléfono…" />
          </div>
          <div class="admin-filter-row" id="admin-drivers-filter">
            <button type="button" class="is-active" data-filter="todos">Todos</button>
            <button type="button" data-filter="disponibles">Disponibles</button>
            <button type="button" data-filter="no-disponibles">No disponibles</button>
            <button type="button" data-filter="deshabilitados">Deshabilitados</button>
          </div>
          <div class="admin-drivers-table-wrap" id="admin-drivers-list"></div>
        </div>
        <div class="admin-menu-section">
          <div class="admin-menu-section-head">
            <h3>Cierres de turno</h3>
          </div>
          <p class="admin-hint">Efectivo esperado vs. entregado al cerrar turno. Por defecto se muestra solo el día de hoy: cambia las fechas para ver otros días.</p>
          <div class="admin-cash-filters">
            <label>Desde <input type="date" id="cash-from" /></label>
            <label>Hasta <input type="date" id="cash-to" /></label>
            <button type="button" class="admin-add-btn" id="cash-today">Hoy</button>
            <select class="admin-category-select" id="cash-driver" aria-label="Domiciliario"></select>
            <select class="admin-category-select" id="cash-status" aria-label="Estado del cierre">
              <option value="todos">Todos los estados</option>
              <option value="cuadrado">Cuadrados</option>
              <option value="faltante">Con faltante</option>
              <option value="sobrante">Con sobrante</option>
            </select>
          </div>
          <div id="admin-cash-settlements-list"></div>
          <div class="admin-pager" id="admin-cash-pager"></div>
        </div>
      </section>

      <!-- Crear domiciliario: mismo criterio que "Producto" en Menú —
           ventana flotante en vez de un formulario pegado en la página,
           que antes alargaba toda la pestaña Domiciliarios aunque
           estuviera cerrado (empujaba la lista de domiciliarios y los
           cierres de turno más abajo). -->
      <div class="modal" id="driver-modal" hidden>
        <div class="drawer-header">
          <h3 id="driver-modal-title">Nuevo domiciliario</h3>
          <button type="button" class="icon-btn" id="btn-close-driver-modal" aria-label="Cerrar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
        </div>
        <form class="admin-form drawer-body" id="driver-form">
          <div class="field">
            <label for="driver-form-name">Nombre</label>
            <input id="driver-form-name" type="text" placeholder="Nombre completo" />
          </div>
          <div class="field">
            <label for="driver-form-phone">Teléfono (para WhatsApp)</label>
            <input id="driver-form-phone" type="tel" placeholder="300 000 0000" />
          </div>
          <div class="field" id="driver-form-email-field">
            <label for="driver-form-email">Correo (para iniciar sesión)</label>
            <input id="driver-form-email" type="email" placeholder="domiciliario@correo.com" />
          </div>
          <div class="field" id="driver-form-password-field">
            <label for="driver-form-password">Contraseña</label>
            <input id="driver-form-password" type="password" minlength="6" placeholder="Mínimo 6 caracteres" />
          </div>
          <label class="checkbox-field" id="driver-form-available-row">
            <input type="checkbox" id="driver-form-available" />
            <span>Dejarlo disponible de una vez (puede empezar a recibir pedidos sin tener que entrar primero a su app)</span>
          </label>
          <div class="admin-form-actions">
            <button type="button" class="btn btn-ghost" id="btn-cancel-driver">Cancelar</button>
            <button type="submit" class="btn btn-primary" id="btn-save-driver">Crear domiciliario</button>
          </div>
        </form>
      </div>

      <!-- --- Reportes --- -->
      <section id="tab-reportes" hidden>
        <div class="admin-menu-section">
          <div class="admin-menu-section-head">
            <h3>Filtrar</h3>
          </div>
          <div class="admin-reports-filter-row">
            <div class="field">
              <label for="reports-filter-from">Desde</label>
              <input id="reports-filter-from" type="date" />
            </div>
            <div class="field">
              <label for="reports-filter-to">Hasta</label>
              <input id="reports-filter-to" type="date" />
            </div>
            <div class="field">
              <label for="reports-filter-zone">Zona</label>
              <select id="reports-filter-zone">
                <option value="">Todas las zonas</option>
              </select>
            </div>
            <button type="button" class="btn btn-ghost" id="btn-reports-filter-clear">Limpiar filtro</button>
          </div>
        </div>
        <div class="admin-menu-section">
          <div class="admin-menu-section-head">
            <h3>Ventas</h3>
          </div>
          <div class="admin-report-grid" id="admin-report-cards"></div>
        </div>
        <div class="admin-menu-section">
          <div class="admin-menu-section-head">
            <h3 id="admin-top-products-heading">Productos más vendidos (últimos 30 días)</h3>
          </div>
          <div id="admin-report-top-products"></div>
        </div>
        <div class="admin-menu-section">
          <div class="admin-menu-section-head">
            <h3>Exportar</h3>
          </div>
          <p class="admin-hint" id="admin-export-hint">Exporta los pedidos de hoy. Si eliges un rango de fechas arriba, exporta ese rango en su lugar.</p>
          <button type="button" class="btn btn-ghost" id="btn-export-orders-csv" style="margin: 0 var(--sp-4) var(--sp-4);">Exportar pedidos de hoy (Excel)</button>
        </div>
      </section>

      <!-- --- Configuración ---
           Antes era una sola página larga con anclas que solo hacían
           scroll ("todo se ve en una página", pedido del usuario) —
           ahora son sub-pestañas de verdad (mismo componente .segmented
           que las pestañas principales), una sección visible a la vez. -->
      <section id="tab-config" hidden>
        <nav class="segmented admin-tabs admin-config-tabs" id="admin-config-tabs">
          <button type="button" data-config-tab="datos" class="is-active">Datos del negocio</button>
          <button type="button" data-config-tab="horario">Horario</button>
          <button type="button" data-config-tab="zonas">Zonas de cobertura</button>
          <button type="button" data-config-tab="avanzado">Avanzado</button>
        </nav>

        <div id="config-section-datos">
          <form class="admin-form" id="settings-form" style="margin: var(--sp-3) var(--sp-4) 0;">
            <div class="field">
              <label for="settings-address">Dirección del restaurante (se muestra en el sitio)</label>
              <input id="settings-address" type="text" placeholder="Calle o avenida, número, barrio, ciudad" maxlength="200" />
            </div>
            <div class="field">
              <label for="settings-phone">Teléfono del restaurante (para el botón de llamar)</label>
              <input id="settings-phone" type="tel" placeholder="+57 300 000 0000" />
            </div>
            <div class="field">
              <label for="settings-min-order">Pedido mínimo a domicilio (COP, 0 = sin mínimo)</label>
              <input id="settings-min-order" type="number" min="0" step="1000" placeholder="0" />
            </div>
            <div class="field">
              <label for="settings-default-fee">Costo de domicilio por defecto (COP)</label>
              <input id="settings-default-fee" type="number" min="0" step="500" placeholder="5000" />
            </div>
            <label class="checkbox-field">
              <input type="checkbox" id="settings-restrict-zones" />
              <span>Rechazar pedidos a domicilio fuera de las zonas de abajo</span>
            </label>
            <div class="admin-form-actions">
              <button type="submit" class="btn btn-primary">Guardar configuración</button>
            </div>
          </form>
        </div>

        <div id="config-section-horario" hidden>
          <!-- Estado en vivo + controles inmediatos (no esperan a "Guardar"). -->
          <section class="horario-estado" id="horario-estado" aria-live="polite">
            <div class="horario-estado-top">
              <span class="horario-luz" id="horario-luz" aria-hidden="true"></span>
              <div>
                <p class="horario-estado-titulo" id="horario-estado-titulo">Cargando…</p>
                <p class="horario-estado-detalle" id="horario-estado-detalle"></p>
              </div>
            </div>
            <div class="horario-acciones">
              <button type="button" class="btn horario-btn-detener" id="btn-detener-pedidos">Detener pedidos</button>
              <button type="button" class="btn horario-btn-pausa" id="btn-pausar-domicilios" aria-pressed="false">Pausar domicilios</button>
            </div>
            <p class="admin-hint">«Detener pedidos» cierra la tienda ya, sin importar el horario, hasta que la reanudes. «Pausar domicilios» deja pedir solo para recoger en tienda (el cajero también puede hacerlo desde la caja).</p>
          </section>

          <form class="admin-form" id="schedule-form" style="margin: var(--sp-3) var(--sp-4) 0;">
            <div class="horario-cabecera">
              <h3>Horario de la semana</h3>
              <div class="horario-copiar">
                <button type="button" class="btn btn-ghost" id="btn-copiar-lun-vie">Copiar lunes a lun–vie</button>
                <button type="button" class="btn btn-ghost" id="btn-copiar-todos">Copiar lunes a todos</button>
              </div>
            </div>
            <p class="admin-hint">Hora de Colombia. La tienda abre y cierra sola con este horario, a domicilio y para recoger.</p>
            <div id="schedule-week-rows" class="schedule-week-rows"></div>

            <div class="field">
              <label for="settings-closed-message">Mensaje cuando detengas los pedidos</label>
              <textarea id="settings-closed-message" rows="2" placeholder="Estamos cerrados en este momento. Vuelve a intentarlo más tarde."></textarea>
              <p class="admin-hint">Fuera del horario no hace falta: el cliente ve solo a qué hora abrimos.</p>
            </div>

            <div class="admin-form-actions">
              <button type="submit" class="btn btn-primary">Guardar horario</button>
            </div>
          </form>
        </div>

        <div id="config-section-zonas" hidden>
          <div class="admin-menu-section">
            <div class="admin-menu-section-head">
              <h3>Zonas de cobertura</h3>
              <button type="button" class="admin-add-btn" id="btn-add-zone">+ Agregar</button>
            </div>
            <p class="admin-hint">Coincide por palabras clave en la dirección (ej: "manzano", "quinta oriental").</p>
            <div id="admin-zones-list"></div>
            <form class="admin-form" id="zone-form" hidden>
              <input type="hidden" id="zone-form-idx" />
              <div class="field">
                <label for="zone-form-name">Nombre de la zona</label>
                <input id="zone-form-name" type="text" placeholder="Ej: Centro" />
              </div>
              <div class="field">
                <label for="zone-form-keywords">Palabras clave (separadas por coma)</label>
                <input id="zone-form-keywords" type="text" placeholder="centro, quinta, manzano" />
              </div>
              <div class="field">
                <label for="zone-form-fee">Costo de domicilio (COP)</label>
                <input id="zone-form-fee" type="number" min="0" step="500" placeholder="5000" />
              </div>
              <div class="admin-form-actions">
                <button type="button" class="btn btn-ghost" id="btn-cancel-zone">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar zona</button>
              </div>
            </form>
          </div>
        </div>

        <!-- Sección técnica, aparte a propósito: no es algo que un
             cajero o dueño necesite ver a diario. -->
        <div id="config-section-avanzado" hidden>
          <div class="admin-menu-section">
            <div class="admin-menu-section-head">
              <h4>Errores recientes</h4>
            </div>
            <p class="admin-hint">Se muestran por día (por defecto hoy), de los últimos 30 registrados — útil si algo no está funcionando bien.</p>
            <div class="admin-cash-filters">
              <label>Día <input type="date" id="errors-day" /></label>
              <button type="button" class="admin-add-btn" id="errors-today">Hoy</button>
            </div>
            <div id="admin-error-log"></div>
            <div class="admin-pager" id="admin-errors-pager"></div>
          </div>
        </div>
      </section>
    </main>

  </div>

  <!-- Plantilla de comanda de cocina — solo se ve al imprimir
       (ver @media print en admin.css); el resto del panel se
       oculta automáticamente en ese momento. -->
  <div id="print-ticket"></div>

  <div class="toast" id="admin-toast"></div>

  <!-- Bloquea el zoom también en iOS Safari (el <meta viewport> solo alcanza en Android/desktop) -->
  <script src="js/disable-zoom.js"></script>
  <script type="module" src="js/admin.js"></script>
  <p class="dev-credit">Desarrollado por <strong>ParaTouch</strong></p>
</body>
</html>
