/* Rodizio Cucuta - ParaTouch (DJG . djgv . Mxi . 0808 . 0724 . uwu) */
/* =========================================================
   Panel de administración — estilos propios
   =========================================================
   Reutiliza variables.css, base.css, layout.css y
   components.css; esto es solo lo específico del panel.
   ========================================================= */

#admin-app {
  /* Sin max-width/margin:auto — mismo criterio que #app en
     layout.css: antes topaba en un ancho fijo desde 720px, dejando
     franjas vacías y el header "cortado" en cualquier tablet o
     monitor intermedio. Ahora ocupa el 100% real; el layout de
     escritorio (barra lateral + grilla, ver más abajo) es lo que
     aprovecha el espacio de más, no un tope de ancho. */
  width: 100%;
  min-height: 100%;
  background: var(--color-bg);
}

/* --- Splash (pantalla de carga) ---
   Mismo splash que ya usa la tienda de clientes (brand.css/animations.css,
   scope #app) — admin.html y driver.html no cargan esos dos archivos, así
   que este bloque se duplica acá (no se agrega un <link> a brand.css
   entero: tiene un montón de reglas de #app sin scope que ensuciarían
   el panel). #splash NO está scoped a #admin-app/#driver-app a propósito
   — el <div id="splash"> vive fuera de esos contenedores, igual que en
   index.html. */
#splash {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--carbon);
  transition: opacity 0.4s ease, visibility 0.4s ease;
}
#splash.is-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
.splash-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22px;
  padding: 24px;
}
.splash-logo {
  width: min(230px, 72vw);
  height: auto;
  max-height: 85px;
  object-fit: contain;
  filter: drop-shadow(0 4px 22px transparent);
  animation: splash-breathe 2s ease-in-out infinite alternate;
}
@keyframes splash-breathe {
  0% { transform: scale(0.98); opacity: 0.92; filter: drop-shadow(0 4px 18px transparent); }
  100% { transform: scale(1.02); opacity: 1; filter: drop-shadow(0 4px 30px transparent); }
}
#splash .spark-line {
  width: 130px;
  height: 3px;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.12);
  overflow: hidden;
  position: relative;
}
#splash .spark-line::after {
  content: '';
  position: absolute;
  inset: 0;
  width: 45%;
  background: linear-gradient(90deg, transparent, var(--marca), var(--aviso), transparent);
  animation: spark-travel 1.1s ease-in-out infinite;
}
@keyframes spark-travel {
  0% { transform: translateX(-120%); }
  100% { transform: translateX(340%); }
}

/* Logo completo en vez del ícono chico + "Panel Rodízio" — antes solo
   se mostraba icon.svg (34x34) con texto, nunca el wordmark real. Sin
   .brand-logo-img (esa es solo de brand.css, scoped a #app) hace falta
   esta regla propia. */
.admin-brand-logo-img {
  height: 32px;
  width: auto;
  max-width: 160px;
  object-fit: contain;
  display: block;
}

/* --- Legibilidad del panel ---
   El cajero/dueño mira esta pantalla horas seguidas — se sube la
   escala de letra completa de esta app (no la del resto del sitio,
   por eso se sobreescribe aquí y no en variables.css). Solo para
   admin — driver.css tiene su propio salto de tamaño, más grande
   todavía (uso en la calle). Con :has() para que también alcance a
   los diálogos de confirmación (confirm.js), que se insertan como
   hijos directos de <body>, fuera de #admin-app. */
body:has(#admin-app) {
  --fs-xs: 0.8125rem;   /* 13px, era 12px */
  --fs-sm: 0.9375rem;   /* 15px, era 14px */
  --fs-base: 1.0625rem; /* 17px, era 16px */
}

/* --- Paleta igual a la del marketplace (a pedido del usuario,
   2026-09-19) ---
   Hasta acá, admin/driver heredaban sin tocar la paleta cálida crema
   de variables.css — pero el marketplace (index.html) tiene su
   propia paleta aparte en brand.css (body:has(#app)), bastante
   distinta: fondo blanco/gris frío en vez de crema, dorado más
   brillante, tipografía de títulos "Plus Jakarta Sans" en vez de
   Anton, sombras neutras en vez de cálidas. El usuario pidió que
   admin y driver se vean IGUAL al marketplace, no solo el rojo — así
   que este bloque copia el mismo set de tokens que brand.css define
   para #app, con el mismo selector `body:has(...)` que ya se usa en
   todo el proyecto para "paleta propia de esta app". Al ser esto
   solo variables, todo lo que ya usa var(--color-*)/var(--font-display)
   en admin.css/driver.css/layout.css/components.css se actualiza solo,
   sin tocar cada regla una por una.
   Si el rojo de marca se vuelve a ajustar en el futuro, hay que tocar
   ACÁ y en brand.css (dos archivos, mismos valores) — no se unificó en
   variables.css a propósito, mismo criterio que ya se usaba para el
   rojo viejo (ver nota histórica en brand.css). */
body:has(#admin-app), body:has(#driver-app) {
  --color-bg: var(--fondo);
  --color-surface: var(--superficie);
  --color-surface-raised: var(--superficie);
  --color-border: var(--borde);
  --color-divider: var(--borde);

  --color-flame: var(--marca);
  --color-flame-hover: var(--marca-hover);
  --color-flame-deep: var(--marca-texto);
  --color-ember: var(--marca-hover);
  --color-flame-glow: transparent;

  --color-charcoal-900: var(--carbon);
  --color-charcoal-800: var(--carbon);
  --color-charcoal-700: var(--carbon);
  --color-charcoal-600: color-mix(in srgb, var(--carbon) 85%, var(--sobre-carbon));

  --color-gold: var(--aviso);
  --color-gold-bright: var(--aviso);
  --color-gold-dark: var(--aviso);

  --color-text: var(--tinta);
  --color-text-muted: var(--tinta-suave);
  --color-text-faint: var(--tinta-suave);

  --color-success: var(--exito);
  --color-danger: var(--marca-texto);

  --font-display: "Plus Jakarta Sans", "Segoe UI", system-ui, sans-serif;

  --shadow-card: var(--sombra-tarjeta);
  --shadow-card-hover: var(--sombra-flotante);
  --shadow-glow-flame: none;
}

/* Tratamiento de encabezados igual al del marketplace (a pedido del
   usuario, 2026-09-19: "esa letra se ve muy grande"). No era un
   problema de tamaño en px — `base.css` sigue poniendo mayúsculas +
   peso 400 + tracking abierto a los h1-h4 (pensado para Anton, una
   tipografía condensada). Con "Plus Jakarta Sans" (ancha, no
   condensada) esa combinación se ve enorme y desproporcionada. Se
   replica el mismo ajuste que brand.css ya usa para #app: negrita,
   sin mayúsculas, tracking cerrado. */
body:has(#admin-app) h1, body:has(#admin-app) h2, body:has(#admin-app) h3, body:has(#admin-app) h4,
body:has(#driver-app) h1, body:has(#driver-app) h2, body:has(#driver-app) h3, body:has(#driver-app) h4 {
  font-weight: 800;
  letter-spacing: -0.025em;
  text-transform: none;
}

/* Fondo detrás del viewport (overscroll/rebote) y color de la barra
   de scroll — mismo criterio que html:has(#app) en brand.css. */
html:has(#admin-app), html:has(#driver-app) {
  scrollbar-color: var(--borde-control) var(--fondo);
  background: var(--fondo);
}

/* Header carbón plano, igual que el marketplace y los paneles del
   restaurante (sistema "Rodízio Brasa", 2026-10): sin línea roja ni
   brillo. Los botones del header van con borde claro, sin relleno. */
body:has(#admin-app) .app-header, body:has(#driver-app) .app-header {
  background: var(--carbon);
  border-bottom: 0;
  box-shadow: none;
}

/* Botones ícono del header (campana de avisos, cuenta) — mismo
   "vidrio oscuro" que brand.css le da a .app-header .icon-btn en el
   marketplace. .icon-btn por defecto (layout.css) es claro, pensado
   para fondos claros — sobre el header oscuro necesita este tratamiento
   aparte, igual que ya se hizo para el fondo del header mismo. */
body:has(#admin-app) .app-header .icon-btn, body:has(#driver-app) .app-header .icon-btn {
  background: transparent;
  border: 1px solid var(--sobre-carbon-borde);
  border-radius: var(--radio-sm);
  color: var(--sobre-carbon);
}
body:has(#admin-app) .app-header .icon-btn:hover, body:has(#driver-app) .app-header .icon-btn:hover {
  background: transparent;
  border-color: var(--sobre-carbon-suave);
  color: var(--sobre-carbon);
}
body:has(#admin-app) .app-header .icon-btn:disabled, body:has(#driver-app) .app-header .icon-btn:disabled {
  opacity: 0.55;
  pointer-events: none;
}
/* .notif-toggle.is-enabled (components.css) marca la campana ya
   activada con un tinte rojo — sin este selector con la misma
   especificidad (el :has(#id) de arriba cuenta como ID), la regla de
   abajo nunca le ganaría a la de acá y la campana se quedaría blanca
   siempre, incluso ya activada. */
body:has(#admin-app) .app-header .icon-btn.is-enabled, body:has(#driver-app) .app-header .icon-btn.is-enabled {
  color: var(--sobre-carbon-marca);
  background: transparent;
  border-color: var(--sobre-carbon-marca);
}

/* --- Sin redondeo (a pedido del usuario, se mantiene) ---
   Esquinas casi rectas en vez de tarjetas/píldoras muy curvas, en las
   dos apps (antes solo admin — driver se quedaba con los radios
   redondos de variables.css, inconsistente con el resto). Los únicos
   `border-radius` hardcodeados que quedan fuera de esto son círculos
   (`50%`) de íconos/avatares — esos SÍ se dejan redondos a propósito,
   "sin redondeo" apunta a tarjetas/botones/pastillas, no a un ícono
   circular que ya es un patrón universal de UI. */
body:has(#admin-app), body:has(#driver-app) {
  --radius-sm: var(--radio-sm);
  --radius-md: var(--radio-sm);
  --radius-lg: var(--radio-sm);
  --radius-pill: var(--radio-sm);
}

/* --- Pantallas de acceso ---
   Mismo lenguaje visual que el hero de la app de clientes (gradiente
   cálido de fondo, insignia circular, tarjeta elevada) para que se
   sienta parte de la misma marca en vez de una pantalla de login
   genérica. */
.admin-gate:not([hidden]) {
  min-height: calc(100vh - var(--header-height));
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-5);
  text-align: center;
  background:
    radial-gradient(120% 60% at 100% 0%, var(--hero-glow-1-soft), transparent 60%),
    radial-gradient(90% 60% at 0% 100%, var(--hero-glow-2-soft), transparent 55%),
    var(--color-bg);
}
.admin-gate-card {
  width: 100%;
  max-width: 360px;
  padding: var(--sp-6) var(--sp-5) var(--sp-5);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-float);
}
.admin-gate-icon {
  width: 56px;
  height: 56px;
  margin: 0 auto var(--sp-4);
  border-radius: var(--radio-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--carbon);
  box-shadow: none;
}
.admin-gate-icon img {
  width: 26px;
  height: 26px;
  filter: brightness(0) invert(1);
}
.admin-gate-icon-locked {
  background: var(--superficie-hundida);
  box-shadow: none;
  color: var(--color-text-muted);
}
/* Logo real del gate de "sin sesión" — antes ese estado solo mostraba
   icon.svg (el ícono cuadrado chico) dentro del círculo de arriba, sin
   ningún wordmark. `.admin-gate-icon` con candado (gate "sin acceso")
   se queda igual, no es este caso. */
.admin-gate-logo {
  width: min(180px, 60%);
  height: auto;
  margin: 0 auto var(--sp-4);
  display: block;
}
.admin-gate-title {
  font-size: var(--fs-xl);
  margin-bottom: var(--sp-3);
}
.admin-gate-text {
  color: var(--color-text-muted);
  font-size: var(--fs-sm);
  margin-bottom: var(--sp-5);
}
.admin-gate #admin-auth-form,
.admin-gate #driver-auth-form {
  text-align: left;
}
.admin-auth-links {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-4);
}
.admin-link-btn {
  font-size: var(--fs-xs);
  font-weight: 700;
  color: var(--color-flame);
}
.admin-link-btn:hover {
  text-decoration: underline;
}

/* --- Tabs y filtros ---
   .admin-tabs reutiliza .segmented (components.css), pensado para
   2-3 botones repartidos en partes iguales — con 6 pestañas eso las
   aplasta y las corta en celular/tablet (se ven picadas o se salen
   de la pantalla). En vez de partes iguales, que se deslice
   horizontal como .admin-filter-row, con cada botón del ancho de su
   texto. A partir de 1080px (ver media query más abajo) esto se
   reemplaza por la barra lateral vertical, donde sí tiene sentido
   que ocupen el ancho completo. */
/* Pegada justo debajo del header en vez de desplazarse con el resto —
   antes, apenas se bajaba en una lista larga (Menú con 130+ productos,
   Pedidos con varias tarjetas), las pestañas desaparecían y había que
   volver arriba del todo para cambiar de sección. Desde 1080px esto se
   sobreescribe más abajo (pasa a barra lateral fija, otro top). */
/* Mismo criterio que .admin-filter-row de más abajo: las pestañas se
   envuelven en vez de desplazarse en horizontal con la barra oculta.
   Aplica a las 6 principales y a las 4 de Configuración, que tienen
   etiquetas largas y eran las que peor se movían en celular. */
.admin-tabs {
  position: sticky;
  top: var(--header-height);
  z-index: 90;
  background: var(--color-bg);
  margin: var(--sp-4);
  flex-wrap: wrap;
}
.admin-tabs button {
  flex: 1 1 auto;
  white-space: nowrap;
}
.admin-search-row {
  padding: 0 var(--sp-4) var(--sp-3);
}
.admin-search-row input {
  width: 100%;
  padding: 10px 14px;
  font-size: var(--fs-sm);
  color: var(--color-text);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-pill);
}
.admin-search-row input::placeholder {
  color: var(--color-text-faint);
}
/* Título corto arriba de cada fila de filtros (fecha / estado) — sin
   esto no quedaba claro para qué servía cada fila de pastillas. */
.admin-filter-label {
  margin: 0;
  padding: 0 var(--sp-4) 6px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--color-text-faint);
}
/* Las pastillas BAJAN DE RENGLÓN en vez de desplazarse en horizontal.
   Antes era `overflow-x:auto` con la barra de scroll oculta: en celular
   había que ir corriendo la fila a ciegas para encontrar un estado (son
   10), sin ninguna señal de que hubiera más opciones fuera de pantalla.
   Envolviéndolas se ven las 10 de un vistazo en 2-3 renglones, y se
   conservan los contadores por estado (.admin-filter-count), que es
   justo lo que se perdería al cambiarlas por un <select>. Arriba de
   1080px esta fila se oculta y se usa el <select> (ver media query al
   final del archivo) — eso no cambia. */
.admin-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
  padding: 0 var(--sp-4) var(--sp-4);
}
.admin-filter-row button {
  min-height: 44px;
  padding: 8px 14px;
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  color: var(--color-text-muted);
  font-size: var(--fs-xs);
  font-weight: 700;
}
.admin-filter-row button.is-active {
  color: var(--sobre-carbon);
  background: var(--carbon);
  border-color: var(--carbon);
}
.admin-filter-count {
  margin-left: 5px;
  opacity: 0.75;
  font-variant-numeric: tabular-nums;
}

/* --- Filtro de categoría en Menú/Inventario: select, no pastillas ---
   Con ~16 categorías, la fila de pastillas obligaba a deslizar para
   ver todas sin dejar claro cuántas más había — un <select> muestra
   la elegida de un vistazo. */
.admin-category-select {
  width: 100%;
  padding: 8px 10px;
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--color-text);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
}
/* .admin-menu-section no trae padding lateral propio (cada hijo se
   encarga del suyo, ver .admin-hint/.admin-filter-row) — este select
   vive suelto ahí (Domiciliarios -> Cierres de turno), sin eso quedaba
   pegado a los bordes de la sección. */
#admin-cash-settlements-filter {
  margin: 0 var(--sp-4) var(--sp-3);
  width: calc(100% - var(--sp-4) * 2);
}
/* Filtro de estado en Pedidos: pastillas en celular (se desliza, normal
   ahí), <select> desde escritorio (ver breakpoint 1080px más abajo) —
   con 10 nombres, buscar deslizando de lado en una pantalla ancha se
   sentía más torpe que en un teléfono. */
.admin-status-select {
  display: none;
  margin: 0 var(--sp-4) var(--sp-4);
  width: calc(100% - var(--sp-4) * 2);
}

/* Fila de filtro por día — mismas pastillas que .admin-filter-row,
   más el selector de fecha exacta al final. */
.admin-date-filter input[type='date'] {
  flex-shrink: 0;
  padding: 7px 12px;
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  color: var(--color-text-muted);
  font-size: var(--fs-xs);
  font-weight: 700;
}

/* Aviso de pedidos nuevos sin ver, en la pestaña "Pedidos" */
.admin-tab-badge[hidden] {
  /* El display:inline-flex de abajo le ganaba al [hidden] del navegador:
     la insignia mostraba "0" aunque admin.js/driver.js la ocultaran. */
  display: none;
}
.admin-tab-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 18px;
  height: 18px;
  margin-left: 6px;
  padding: 0 5px;
  border-radius: var(--radius-pill);
  background: var(--color-flame);
  color: var(--sobre-marca);
  font-size: 12px;
  font-weight: 800;
  vertical-align: middle;
}

.admin-hint {
  color: var(--color-text-faint);
  font-size: var(--fs-xs);
  padding: 0 var(--sp-4) var(--sp-4);
}

/* --- Horario semanal (Configuración) --- */
.schedule-week-rows {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  margin: var(--sp-2) 0 var(--sp-4);
}
.schedule-day-row {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  flex-wrap: wrap;
  padding: var(--sp-2) var(--sp-3);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
}
.schedule-day-label {
  min-width: 84px;
  font-weight: 600;
  font-size: var(--fs-sm);
}
.schedule-day-row .checkbox-field {
  margin: 0;
  flex: none;
}
.schedule-day-sep {
  color: var(--color-text-faint);
  font-size: var(--fs-xs);
}
.schedule-day-row input[type='time'] {
  width: auto;
}
.schedule-day-row input[type='time']:disabled {
  opacity: 0.5;
}

/* --- Tarjeta de pedido --- */
.admin-order {
  margin: 0 var(--sp-4) var(--sp-3);
  padding: var(--sp-4);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
/* Pedido sin avanzar de estado hace rato (o con hora programada
   encima) — salta a la vista para que no se quede esperando. */
.admin-order.is-urgent {
  border-color: var(--color-danger);
  box-shadow: 0 0 0 1px transparent;
}
.admin-order.is-cancelled {
  opacity: 0.65;
}
.admin-order-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--sp-3);
  margin-bottom: var(--sp-3);
}
/* Sin min-width:0 acá, un nombre de cliente largo y sin espacios no se
   encoge (comportamiento por defecto de un hijo flex) y empuja toda la
   tarjeta — y con ella la página entera — más ancha que la pantalla. */
.admin-order-top-info {
  min-width: 0;
}
.admin-order-customer {
  overflow-wrap: anywhere;
}
.admin-order-top-actions {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}
.admin-print-btn {
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-faint);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.admin-print-btn:hover {
  color: var(--color-text);
}
.admin-order-chip-cancelled {
  color: var(--color-danger);
  background: var(--marca-tinte);
  border-color: color-mix(in srgb, var(--marca) 40%, transparent);
}
.admin-order-chip-tip {
  color: var(--color-gold);
  background: var(--aviso-tinte);
  border-color: color-mix(in srgb, var(--aviso) 40%, transparent);
}
.admin-order-history {
  margin-top: var(--sp-3);
  font-size: var(--fs-xs);
  color: var(--color-text-faint);
}
.admin-order-history summary {
  cursor: pointer;
  font-weight: 700;
  color: var(--color-text-muted);
}
.admin-history-entry {
  padding: 4px 0 4px var(--sp-3);
  border-left: 2px solid var(--color-border);
  margin-left: 4px;
}
.admin-order-history-more {
  margin-left: 4px;
}
.admin-order-history-more summary {
  cursor: pointer;
  padding: 4px 0 4px var(--sp-3);
  border-left: 2px solid var(--color-border);
  color: var(--color-flame);
  font-weight: 700;
}
.admin-order-customer {
  font-weight: 800;
  font-size: var(--fs-sm);
}
.admin-order-meta {
  font-size: var(--fs-xs);
  color: var(--color-text-faint);
  margin-top: 2px;
}
.admin-order-summary-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-top: 4px;
}
/* --- Acordeón: nombre + total visibles siempre, el resto (incluido
   el teléfono/WhatsApp) queda plegado hasta que se toca "Ver detalle" --- */
.admin-order-toggle-wrap {
  margin-top: var(--sp-2);
}
.admin-order-toggle {
  cursor: pointer;
  list-style: none;
  font-size: var(--fs-xs);
  font-weight: 700;
  color: var(--color-flame);
}
.admin-order-toggle::-webkit-details-marker {
  display: none;
}
.admin-order-toggle::before {
  content: '▸ Ver detalle';
}
.admin-order-toggle-wrap[open] > .admin-order-toggle::before {
  content: '▾ Ocultar detalle';
}
.admin-order-detail-body {
  margin-top: var(--sp-3);
  padding-top: var(--sp-3);
  border-top: 1px dashed var(--color-border);
}
.admin-order-phone {
  color: var(--color-text-faint);
  text-decoration: underline dotted;
}
.admin-order-phone:hover {
  color: var(--color-flame);
}
/* Ícono de WhatsApp junto al teléfono del cliente — antes solo se
   podía llamar (tel:), sin forma directa de escribirle. */
.admin-order-whatsapp-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  margin-left: 6px;
  vertical-align: middle;
  color: #25d366;
}
.admin-order-whatsapp-btn:hover {
  opacity: 0.8;
}
.admin-order-address {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: var(--fs-xs);
  color: var(--color-text-muted);
  margin-bottom: var(--sp-2);
}
.admin-copy-btn {
  flex-shrink: 0;
  width: 22px;
  height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-faint);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
}
.admin-copy-btn:hover {
  color: var(--color-text);
}
.admin-order-items {
  font-size: var(--fs-xs);
  color: var(--color-text-muted);
  margin-bottom: var(--sp-2);
  line-height: 1.6;
}
.admin-order-item-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 3px 0;
}
.admin-order-item-thumb {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
}
.admin-order-item-thumb-empty {
  display: inline-block;
}
.admin-order-item-text em {
  font-style: normal;
  color: var(--color-text-faint);
}
.admin-order-reference {
  margin-top: 4px;
  color: var(--color-text-faint);
}
.admin-order-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: var(--sp-3);
}
.admin-order-chip {
  display: inline-flex;
  align-items: center;
  font-size: 12px;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: var(--radius-pill);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  color: var(--color-text-faint);
}
.admin-order-chip-scheduled {
  color: var(--color-gold);
  background: var(--aviso-tinte);
  border-color: color-mix(in srgb, var(--aviso) 40%, transparent);
}
.admin-order-chip-urgent {
  color: var(--color-danger);
  background: var(--marca-tinte);
  border-color: color-mix(in srgb, var(--marca) 40%, transparent);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
/* Antes esto era una fila/grilla con los 7 estados de la escalera
   pintados como botones (la mayoría deshabilitados) — se veía como
   una fila larga sin poder tocar casi nada. Ahora solo el estado
   actual (texto) + un único botón con la próxima acción disponible. */
.admin-status-buttons {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--sp-2);
}
.admin-status-waiting {
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  border: 1px dashed var(--color-border);
  color: var(--color-text-muted);
  font-size: 12.5px;
  line-height: 1.4;
  text-align: center;
}
.admin-status-current {
  font-size: 12.5px;
  color: var(--color-text-muted);
}
.admin-status-current strong {
  color: var(--color-text);
}
.admin-status-next-btn {
  padding: 9px 16px;
  border-radius: var(--radius-sm);
  background: var(--color-flame);
  border: 1px solid var(--color-flame);
  color: var(--color-bg);
  font-size: 12.5px;
  font-weight: 800;
  text-transform: uppercase;
}
.admin-status-next-btn:disabled {
  pointer-events: none;
  opacity: 0.55;
}
/* Mientras se guarda el cambio de estado: el botón pulsa suavemente
   para dejar claro que se está procesando. */
.admin-status-buttons.is-saving .admin-status-next-btn.is-pending {
  animation: admin-status-pulse 0.9s ease-in-out infinite;
}
@keyframes admin-status-pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.55;
  }
}

/* Destello en la tarjeta de un pedido recién llegado — antes
   aparecía de golpe con el repintado agrupado (scheduleRenderOrders
   en admin.js), sin ninguna señal visual de "esto es nuevo" aparte
   del sonido/toast/badge que ya existían. `.is-new-arrival` la pone
   admin.js (`renderOrderCard`) solo en el primer repintado tras
   llegar — se apaga sola (no usa `animation-fill-mode: both`), así
   no hace falta quitar la clase a mano para que el estilo final
   quede limpio. */
@keyframes new-order-flash {
  0% { box-shadow: 0 0 0 2px var(--color-flame), 0 0 24px color-mix(in srgb, var(--color-flame) 50%, transparent); }
  100% { box-shadow: 0 0 0 2px transparent, 0 0 0 transparent; }
}
.admin-order.is-new-arrival {
  animation: new-order-flash 1.6s ease-out;
}

/* --- Tiempo estimado (ETA) --- */
.admin-eta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: var(--sp-3);
}
.admin-eta-label {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--color-text-faint);
  margin-right: 2px;
}
.admin-eta-btn {
  padding: 5px 10px;
  font-size: 13px;
  font-weight: 700;
  color: var(--color-text-muted);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-pill);
}
.admin-eta-btn:active {
  transform: scale(0.95);
}
.admin-eta-btn.is-suggested {
  color: var(--color-flame);
  border-color: color-mix(in srgb, var(--color-flame) 40%, transparent);
  background: color-mix(in srgb, var(--color-flame) 10%, transparent);
}

/* --- Asignar domiciliario --- */
.admin-driver-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: var(--sp-3);
}
.admin-driver-label {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--color-text-faint);
}
.admin-driver-select {
  flex: 1;
  min-width: 140px;
  padding: 6px 8px;
  font-size: var(--fs-xs);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text);
}
.admin-driver-map-link {
  font-size: 12px;
  font-weight: 700;
  color: var(--exito);
  white-space: nowrap;
}
.admin-customer-map-link {
  color: var(--info);
}
.admin-driver-map-stale {
  color: var(--color-danger);
}

/* --- "No se pudo entregar" — reintentar --- */
.admin-retry-btn {
  grid-column: 1 / -1;
  padding: 10px 4px;
  border-radius: var(--radius-sm);
  background: var(--color-flame);
  border: 1px solid var(--color-flame);
  color: var(--color-bg);
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
}
.admin-retry-btn:active {
  transform: scale(0.98);
}

/* --- Nota interna del pedido --- */
.admin-order-note {
  margin-top: var(--sp-3);
  font-size: var(--fs-xs);
}
.admin-order-note summary {
  cursor: pointer;
  font-weight: 700;
  color: var(--color-text-faint);
}
.admin-note-input {
  width: 100%;
  margin-top: 6px;
  padding: 8px;
  font-size: var(--fs-xs);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text);
  resize: vertical;
}
.admin-note-save {
  margin-top: 6px;
  padding: 6px 12px;
  font-size: 13px;
}

/* --- Bloquear cliente --- */
.admin-block-btn {
  display: block;
  width: 100%;
  margin-top: var(--sp-3);
  padding: 8px;
  font-size: var(--fs-xs);
  font-weight: 700;
  color: var(--color-danger);
  background: var(--marca-tinte);
  border: 1px solid color-mix(in srgb, var(--marca) 30%, transparent);
  border-radius: var(--radius-sm);
}
.admin-block-btn.is-blocked {
  color: var(--color-text-muted);
  background: var(--color-bg);
  border-color: var(--color-border);
}
/* Spinner de carga — mismo espíritu que los botones de acción de
   domiciliarios (solo el spinner, sin check de éxito): la tarjeta del
   pedido se vuelve a pintar apenas Firebase confirma el cambio, así
   que un check con su propia pausa nunca llegaría a verse completo.
   Solo cambia a flex mientras carga, para centrar el spinner junto al
   texto sin afectar el layout normal del botón. */
.admin-block-btn.is-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  pointer-events: none;
  opacity: 0.75;
}
.admin-block-btn.is-loading::before {
  content: '';
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2px solid color-mix(in srgb, var(--marca) 30%, transparent);
  border-top-color: var(--color-danger);
  animation: btn-spin 0.7s linear infinite;
  flex-shrink: 0;
}

/* --- Cargar pedidos anteriores (paginación) --- */
.admin-load-more-btn {
  display: block;
  width: calc(100% - var(--sp-4) * 2);
  grid-column: 1 / -1;
  margin: 0 var(--sp-4) var(--sp-4);
  padding: var(--sp-3);
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--color-text-muted);
  background: var(--color-surface);
  border: 1px dashed var(--color-border);
  border-radius: var(--radius-md);
}

/* --- Errores recientes --- */
.admin-error-row {
  margin: 0 var(--sp-4) var(--sp-2);
  padding: var(--sp-3);
  background: var(--color-surface);
  border: 1px solid color-mix(in srgb, var(--marca) 30%, transparent);
  border-radius: var(--radius-md);
}
.admin-error-top {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
  color: var(--color-danger);
  margin-bottom: 4px;
}
.admin-error-message {
  font-size: var(--fs-xs);
  color: var(--color-text-muted);
  word-break: break-word;
}

/* --- Inventario --- agrupado por categoría; un solo estado por producto
   (Disponible / Agotado / Oculto, ver stockStatusOf en admin.js). */
.admin-stock-group {
  margin: 0 0 var(--sp-5);
}
.admin-stock-group-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-2);
  margin: 0 var(--sp-4) var(--sp-2);
  font-size: var(--fs-sm);
  font-weight: 800;
}
.admin-stock-group-head span {
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--color-text-muted);
}
.admin-stock-grid {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}
.admin-stock-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--sp-3);
  margin: 0 var(--sp-4);
  padding: var(--sp-3);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}
.admin-stock-row.is-oculto {
  opacity: 0.65;
}
.admin-stock-row img {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-sm);
  object-fit: cover;
  flex-shrink: 0;
}
.admin-stock-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.admin-stock-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--fs-sm);
  font-weight: 700;
}
.admin-stock-state {
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}
.admin-stock-state.is-disponible { color: var(--color-success); }
.admin-stock-state.is-pocas { color: var(--color-gold); }
.admin-stock-state.is-agotado { color: var(--color-danger); }
.admin-stock-state.is-oculto { color: var(--color-text-faint); }
.admin-stock-controls {
  flex: 1 1 100%;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--sp-3);
}
.admin-stock-seg {
  display: inline-flex;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-pill);
  overflow: hidden;
}
.admin-stock-seg button {
  min-height: 36px;
  padding: 6px 14px;
  background: var(--color-surface);
  color: var(--color-text-muted);
  font-size: var(--fs-xs);
  font-weight: 700;
}
.admin-stock-seg button + button {
  border-left: 1px solid var(--color-border);
}
.admin-stock-seg button.is-active {
  color: var(--color-bg);
}
.admin-stock-seg button.is-disponible { background: var(--color-success); }
.admin-stock-seg button.is-agotado { background: var(--color-danger); }
.admin-stock-seg button.is-oculto { background: var(--color-text-faint); }
.admin-stock-units {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-2);
  font-size: var(--fs-xs);
  color: var(--color-text-muted);
}
.admin-stock-count {
  width: 84px;
  padding: 6px 8px;
  text-align: center;
  font-size: var(--fs-sm);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text);
}
.admin-stock-locked {
  padding: 0;
}
@media (min-width: 720px) {
  .admin-stock-group-head { margin: 0 0 var(--sp-2); }
  .admin-stock-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .admin-stock-row { margin: 0; }
}
@media (min-width: 1080px) {
  .admin-stock-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}

/* --- Menú: categorías y productos --- */
.admin-seed-banner {
  margin: 0 var(--sp-4) var(--sp-5);
  padding: var(--sp-4);
  background: var(--aviso-tinte);
  border: 1px solid color-mix(in srgb, var(--aviso) 40%, transparent);
  border-radius: var(--radius-md);
  text-align: center;
}
.admin-seed-banner p {
  color: var(--color-gold);
  font-size: var(--fs-sm);
  margin-bottom: var(--sp-3);
}

.admin-menu-section {
  margin-bottom: var(--sp-6);
}
.admin-menu-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  padding: 0 var(--sp-4) var(--sp-3);
}
.admin-menu-section-head h3,
.admin-menu-section-head h4 {
  font-size: var(--fs-md);
  text-transform: none;
  font-family: var(--font-body);
  font-weight: 800;
  min-width: 0;
  overflow-wrap: anywhere;
}
.admin-menu-section-head .admin-add-btn {
  flex-shrink: 0;
}
.admin-menu-section-head h4 {
  font-size: var(--fs-sm);
  color: var(--color-text-muted);
}

/* --- Sub-pestañas de Configuración (Datos/Horario/Zonas/Avanzado) ---
   Antes era una sola página larga con anclas de scroll ("todo se ve en
   una página", pedido del usuario) — .admin-config-tabs reutiliza el
   mismo componente .segmented que las pestañas principales, con
   .admin-tabs solo para heredar el look. El selector con #tab-config
   es a propósito más específico que ".admin-tabs" (incluida su versión
   de escritorio en el breakpoint de 1080px, más abajo en este archivo)
   — sin esto, a partir de esa pantalla esta barra intentaba convertirse
   también en la barra lateral fija de navegación principal. */
#tab-config .admin-config-tabs {
  position: static;
  margin: var(--sp-4);
  grid-column: unset;
  grid-row: unset;
  flex-direction: row;
  overflow-x: auto;
  top: auto;
}
/* Sin esto, desde 1080px estos botones heredaban el estilo de la barra
   lateral vertical de escritorio (texto a la izquierda, más padding,
   radio de esquina en vez de píldora) — se ven bien horizontales en
   cualquier ancho, no solo en celular. */
#tab-config .admin-config-tabs button {
  text-align: center;
  white-space: nowrap;
  padding: 10px;
  font-size: var(--fs-sm);
  border-radius: var(--radius-pill);
}

.admin-clear-errors-btn {
  width: auto;
  padding: 6px 12px;
  font-size: var(--fs-xs);
  color: var(--color-danger);
}
.admin-add-btn {
  font-size: var(--fs-xs);
  font-weight: 800;
  color: var(--color-flame);
  background: color-mix(in srgb, var(--color-flame) 12%, transparent);
  border: 1px solid color-mix(in srgb, var(--color-flame) 35%, transparent);
  border-radius: var(--radius-pill);
  padding: 6px 12px;
}

.admin-item-row {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  margin: 0 var(--sp-4) var(--sp-2);
  padding: var(--sp-3);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}
.admin-item-row img {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-sm);
  object-fit: cover;
  flex-shrink: 0;
}
.admin-item-info {
  flex: 1;
  min-width: 0;
}
.admin-item-name {
  font-size: var(--fs-sm);
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}
.admin-item-meta {
  font-size: var(--fs-xs);
  color: var(--color-text-faint);
}
.admin-item-actions {
  display: flex;
  gap: 6px;
  flex-shrink: 0;
}
.admin-item-actions button {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-muted);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
}
.admin-item-actions button.admin-delete-btn {
  color: var(--color-danger);
}

/* --- Categorías: tarjeta que se abre + detalle de la categoría --- */
.admin-item-open {
  display: block;
  padding: 0;
  background: none;
  border: 0;
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
}
.admin-item-open .admin-item-name,
.admin-item-open .admin-item-meta {
  display: block;
}
.admin-item-open:hover .admin-item-name {
  text-decoration: underline;
}
.admin-category-detail {
  padding: var(--sp-4);
}
.admin-category-detail .admin-menu-section-head {
  margin: var(--sp-4) 0 var(--sp-2);
  padding: 0;
}
.admin-category-detail .admin-menu-section-head:first-child {
  margin-top: 0;
}
.admin-category-detail .admin-item-row {
  margin: 0 0 var(--sp-2);
}
.admin-category-detail .admin-search-row {
  padding: 0;
  margin-bottom: var(--sp-3);
}
.admin-item-actions .admin-move-select {
  width: auto;
  max-width: 130px;
  height: 32px;
  border-radius: var(--radius-pill);
  font-size: var(--fs-xs);
}
.admin-item-actions .admin-add-existing-btn {
  width: auto;
  height: auto;
  padding: 6px 14px;
  border-radius: var(--radius-pill);
  font-size: var(--fs-xs);
  font-weight: 700;
}

/* --- Edición inline de categoría (reemplaza el formulario aparte) --- */
.admin-category-editing {
  border-color: var(--color-flame);
}
.admin-category-edit-name {
  flex: 1;
  min-width: 0;
  padding: 6px 8px;
  font-size: var(--fs-sm);
  font-weight: 700;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text);
}
.admin-category-edit-order {
  width: 64px;
  flex-shrink: 0;
  padding: 6px 8px;
  font-size: var(--fs-sm);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text);
}
.admin-category-save-btn {
  color: var(--color-flame);
}

/* --- Filtro de Reportes (fecha + zona) --- */
.admin-reports-filter-row {
  display: flex;
  align-items: flex-end;
  gap: var(--sp-3);
  flex-wrap: wrap;
  margin: 0 var(--sp-4) var(--sp-3);
}
.admin-reports-filter-row .field {
  margin: 0;
  flex: 1 1 140px;
  min-width: 140px;
}

/* --- Tarjetas de domiciliario (pestaña Domiciliarios) --- */
/* Grid explícito, no una fila que se pueda encimar: cada tarjeta
   ocupa su propia celda, siempre. */
.admin-drivers-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--sp-3);
  margin: var(--sp-3) var(--sp-4);
}
.admin-driver-card {
  padding: var(--sp-3);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}
.admin-driver-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}
.admin-driver-card-name {
  font-size: var(--fs-sm);
  font-weight: 700;
}
.admin-driver-card-icons {
  display: flex;
  gap: 6px;
  flex-shrink: 0;
}
.admin-driver-card-icons button {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-muted);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
}
.admin-driver-card-icons button.admin-delete-btn {
  color: var(--color-danger);
}
/* Es un <span> cuando el domiciliario está deshabilitado (nada que
   tocar ahí) y un <button> cuando sí se puede marcar disponible/no
   disponible con un toque — mismo look en los dos casos, solo cambia
   si reacciona al cursor/tacto. */
.admin-driver-card-badge {
  align-self: flex-start;
  font-size: var(--fs-xs);
  font-weight: 600;
  padding: 2px 10px;
  border: none;
  border-radius: var(--radius-sm);
  white-space: nowrap;
}
/* Antes era exactamente igual a un badge de solo lectura (sin borde,
   sin ningún indicio de que se podía tocar) — "no se entiende eso"
   (pedido del usuario). Ahora, cuando SÍ se puede tocar (domiciliario
   habilitado), lleva borde, un ícono de doble flecha y un hover/active
   más marcado, para que se note que es un interruptor, no una etiqueta. */
button.admin-driver-card-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  cursor: pointer;
  border-width: 1px;
  border-style: solid;
  transition: transform 0.1s ease, filter 0.15s ease;
}
button.admin-driver-card-badge:hover {
  filter: brightness(0.95);
}
button.admin-driver-card-badge:active {
  transform: scale(0.96);
}
button.admin-driver-card-badge.is-available {
  border-color: var(--exito);
}
button.admin-driver-card-badge.is-offline {
  border-color: var(--color-border);
}
.admin-driver-card-badge.is-available {
  color: var(--exito);
  background: var(--exito-tinte);
}
.admin-driver-card-badge.is-offline {
  color: var(--color-text-muted);
  background: var(--color-bg);
}
.admin-driver-card-badge.is-disabled {
  color: var(--color-danger);
  background: color-mix(in srgb, var(--color-danger) 12%, transparent);
}
.admin-driver-card-meta {
  font-size: var(--fs-xs);
  color: var(--color-text-faint);
}
.admin-driver-card-actions {
  display: flex;
  gap: var(--sp-2);
  flex-wrap: wrap;
}
.admin-driver-whatsapp-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--exito);
}

@media (min-width: 720px) {
  .admin-drivers-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (min-width: 1080px) {
  .admin-drivers-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

.admin-form {
  margin: var(--sp-3) var(--sp-4) 0;
  padding: var(--sp-4);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}
/* El formulario de producto vive dentro de la ventana flotante
   (.modal ya trae su propia tarjeta/fondo, y .drawer-body ya trae su
   propio padding) — sin esto se veía una tarjeta anidada dentro de
   otra tarjeta, con doble borde y doble margen. */
.modal .admin-form {
  margin: 0;
  background: none;
  border: none;
  border-radius: 0;
}
.admin-form-actions {
  display: flex;
  gap: var(--sp-3);
}
.admin-form-actions .btn {
  width: auto;
  flex: 1;
  padding: 10px 16px;
  font-size: var(--fs-sm);
}

/* =========================================================
   Responsivo — tablet y escritorio
   =========================================================
   En celular el panel es una sola columna de arriba a abajo
   (como quedó por defecto). Desde tablet se aprovecha el ancho
   extra ensanchando el panel; desde escritorio las pestañas se
   convierten en un menú lateral fijo y las listas pasan de
   una columna a una grilla, para no dejar todo el texto
   estirado de borde a borde de la pantalla.
   ========================================================= */
@media (min-width: 720px) {
  #admin-orders-list,
  #admin-categories-list,
  #admin-products-list,
  #admin-zones-list {
    display: grid;
    /* minmax(0, 1fr), NO solo "1fr": una columna 1fr sola es en
       realidad minmax(auto, 1fr) por spec — "auto" no deja que la
       columna se achique más abajo del contenido más ancho que le
       toque (un nombre largo, ej. en Inventario), así que las 2/3/4
       columnas terminaban con anchos disparejos que sumaban MÁS que
       el ancho real disponible y empujaban la página entera. Con
       minmax(0, 1fr) las columnas sí se reparten parejas de verdad. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-3);
    padding: 0 var(--sp-4);
  }
  /* Sin esto, el grid por defecto estira TODAS las tarjetas de una fila
     a la altura de la más alta — al abrir "Ver detalle" en una sola
     tarjeta, las otras 2 de su misma fila se estiraban con ella (aunque
     su contenido siguiera colapsado), dando la sensación de que las 3
     "se movían" en vez de solo la que se abrió. */
  #admin-orders-list {
    align-items: start;
    /* Mismo min-width:0 que #tab-* más abajo, un nivel más adentro:
       cada uno de estos grids es a su vez hijo de un grid de escritorio
       (#admin-main) — sin esto, el ancho de contenido de sus propias
       tarjetas (ej. Inventario, con nombre+contador+botón "Ocultar")
       puede seguir empujando el panel más ancho que la pantalla aunque
       el contenedor padre ya esté corregido. */
    min-width: 0;
  }
  /* Categorías/Productos: tarjetas angostas (nombre + precio corto)
     quedaban MUY anchas repartidas en solo 2/3/4 columnas fijas —
     auto-fill mete tantas como quepan a este ancho mínimo en vez de
     estirarlas, y ya no hace falta redeclarar esto en los breakpoints
     de más abajo (crece solo con el ancho de pantalla). */
  #admin-categories-list,
  #admin-products-list {
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    /* Sin esto, una grilla auto-fill anidada dentro de una columna 1fr
       (#admin-main de más abajo) puede reportar un ancho de contenido
       más grande que el que en verdad tiene disponible — el min-width
       por defecto de un hijo de grid es "auto" (no se encoge), así que
       sin min-width:0 la grilla empuja la página entera más ancha que
       la pantalla. Mismo tipo de bug que ya se corrigió antes en este
       proyecto con .header-actions (ver tienda/CLAUDE.md). */
    min-width: 0;
  }
  /* La fila en edición necesita más espacio que una tarjeta angosta de
     categoría (nombre + orden + 2 botones) — ocupa el ancho completo
     de la grilla mientras se está editando. */
  .admin-category-editing {
    grid-column: 1 / -1;
  }
  .admin-order,
  .admin-stock-row,
  .admin-item-row {
    margin: 0;
  }
}

@media (min-width: 1080px) {
  .app-header {
    padding-left: var(--sp-6);
    padding-right: var(--sp-6);
  }

  #admin-main:not([hidden]) {
    display: grid;
    grid-template-columns: 200px 1fr;
    align-items: start;
    gap: var(--sp-6);
    padding: var(--sp-5) var(--sp-6) var(--sp-7);
  }

  .admin-tabs {
    grid-column: 1;
    grid-row: 1 / -1;
    flex-direction: column;
    overflow-x: visible;
    align-self: start;
    gap: 4px;
    position: sticky;
    top: calc(var(--header-height) + var(--sp-5));
    margin: 0;
    padding: var(--sp-2);
    border-radius: var(--radius-lg);
  }
  .admin-tabs button {
    text-align: left;
    white-space: normal;
    padding: 12px var(--sp-3);
    font-size: var(--fs-sm);
    border-radius: var(--radius-md);
  }

  #tab-pedidos,
  #tab-inventario,
  #tab-menu,
  #tab-domiciliarios,
  #tab-reportes,
  #tab-config {
    grid-column: 2;
    /* La causa real del "las tarjetas se salen de la página": sin esto,
       el ancho de contenido intrínseco de lo que hay adentro (sobre
       todo .admin-filter-row con ~16 pastillas de categoría, que en
       Pedidos son menos y más cortas y por eso no se notaba ahí) hacía
       que la sección se negara a encogerse a los ~200px+1fr disponibles
       de esta grilla — empujando el panel entero más ancho que la
       pantalla. min-width:auto es el valor por defecto de un hijo de
       grid; acá se necesita 0 para que SÍ respete el ancho de columna
       disponible y deje el overflow-x:auto interno (.admin-filter-row)
       hacer su trabajo en vez de filtrarse hacia afuera. */
    min-width: 0;
  }

  .admin-filter-row {
    padding: 0 0 var(--sp-4);
  }
  #admin-status-filter {
    display: none;
  }
  .admin-status-select {
    display: block;
    margin: 0 0 var(--sp-4);
    width: 100%;
    max-width: 320px;
  }
  #admin-orders-list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0;
  }
  #admin-categories-list,
  #admin-products-list,
  #admin-zones-list {
    padding: 0;
  }
  #admin-zones-list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .admin-hint {
    padding: 0 0 var(--sp-4);
  }

  .admin-menu-section {
    max-width: none;
  }
  .admin-form {
    max-width: 480px;
    margin: var(--sp-3) 0 0;
  }
  .admin-seed-banner {
    margin: 0 0 var(--sp-5);
  }
}

/* --- Monitor de escritorio grande --- una columna más en las
   grillas de tarjetas para que el espacio de más (el panel ya ocupa
   el 100% del ancho real, sin tope) se aproveche con contenido. */
@media (min-width: 1440px) {
  #admin-orders-list,
  #admin-zones-list {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  /* categorías/productos: auto-fill (ver bloque de 720px) ya agrega
     columnas solo al crecer el ancho, no hace falta redeclarar acá. */
}

/* --- Franja de números rápidos (pestaña Pedidos) --- */
.admin-quick-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-2);
  margin: var(--sp-4) var(--sp-4) var(--sp-3);
}
.admin-quick-stat {
  padding: var(--sp-3) var(--sp-2);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  text-align: center;
}
.admin-quick-stat-value {
  display: block;
  font-family: var(--font-display);
  font-size: var(--fs-lg);
  color: var(--tinta);
  line-height: 1.1;
}
.admin-quick-stat-label {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  font-weight: 700;
  color: var(--color-text-faint);
  text-transform: uppercase;
  letter-spacing: 0.02em;
}
.admin-quick-stat.is-alert .admin-quick-stat-value {
  color: var(--color-danger);
}

/* =========================================================
   Reportes
   ========================================================= */
.admin-report-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--sp-3);
  margin: 0 var(--sp-4) var(--sp-5);
}
.admin-report-card {
  padding: var(--sp-4);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.admin-report-value {
  font-family: var(--font-display);
  font-size: var(--fs-xl);
  color: var(--tinta);
}
.admin-report-label {
  font-size: var(--fs-xs);
  color: var(--color-text-faint);
}

/* =========================================================
   Comanda de cocina (imprimir)
   =========================================================
   #print-ticket vive siempre oculto en la pantalla normal; solo
   se muestra dentro del diálogo de impresión, y ahí se oculta
   todo lo demás — así se imprime solo el ticket, sin el resto
   del panel alrededor.
   ========================================================= */
#print-ticket {
  display: none;
}
@media print {
  /* Antes: `body * { visibility: hidden }` + reexponer #print-ticket.
     El problema de fondo: `visibility: hidden` NO saca el elemento del
     flujo del documento — el panel entero (#admin-app, con toda la
     lista de pedidos, modales, etc.) seguía ocupando su alto real
     aunque fuera invisible, así que el navegador igual generaba tantas
     páginas en blanco como hicieran falta para "imprimir" ese alto
     vacío (5 páginas en blanco con una comanda de una sola página).
     Arreglado con `display: none` en cada hijo directo del body salvo
     #print-ticket — eso sí saca todo lo demás del flujo por completo,
     así que el documento impreso mide exactamente lo que mide la
     comanda. */
  body > *:not(#print-ticket) {
    display: none !important;
  }
  #print-ticket {
    display: block;
    position: static;
    width: 100%;
  }
  .ticket {
    padding: 12px;
    font-family: 'Courier New', monospace;
    color: #000;
  }
  .ticket-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 4px;
  }
  .ticket-logo {
    width: 22px;
    height: 22px;
  }
  .ticket h2 {
    margin: 0 0 6px;
    font-size: 16px;
    text-align: center;
  }
  .ticket-order-number {
    margin: 0 0 6px;
    text-align: center;
    font-weight: bold;
    font-size: 15px;
    letter-spacing: 0.5px;
  }
  .ticket hr {
    border: none;
    border-top: 1px dashed #000;
    margin: 8px 0;
  }
  .ticket-item {
    font-size: 13px;
  }
  .ticket-notes {
    font-size: 11px;
    font-style: italic;
    margin-left: 8px;
  }
}

/* --- Horario (2026-10-07): estado en vivo + semana --- */
.horario-estado {
  margin: var(--sp-3) var(--sp-4) 0;
  padding: var(--sp-4);
  border-radius: 16px;
  border: 1px solid var(--borde);
  background: var(--superficie);
  display: grid;
  gap: var(--sp-3);
}
.horario-estado-top {
  display: flex;
  align-items: center;
  gap: 12px;
}
.horario-luz {
  flex: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--tinta-suave);
}
.horario-estado[data-estado="abierto"] { border-color: var(--exito); background: var(--exito-tinte); }
.horario-estado[data-estado="abierto"] .horario-luz { background: var(--exito); box-shadow: 0 0 0 4px rgba(46, 110, 71, 0.18); }
.horario-estado[data-estado="pausado"] { border-color: var(--aviso); background: var(--aviso-tinte); }
.horario-estado[data-estado="pausado"] .horario-luz { background: var(--aviso); box-shadow: 0 0 0 4px rgba(125, 82, 0, 0.18); }
.horario-estado[data-estado="cerrado"] { border-color: var(--marca-borde); background: var(--marca-tinte); }
.horario-estado[data-estado="cerrado"] .horario-luz { background: var(--marca); box-shadow: 0 0 0 4px rgba(181, 42, 32, 0.18); }
.horario-estado-titulo {
  margin: 0;
  font-weight: 800;
  font-size: var(--fs-md);
  color: var(--tinta);
}
.horario-estado-detalle {
  margin: 2px 0 0;
  font-size: var(--fs-sm);
  color: var(--tinta-suave);
}
.horario-acciones {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
}
.horario-acciones .btn {
  flex: 1 1 160px;
  min-height: 46px;
  font-weight: 800;
}
.horario-btn-detener {
  background: var(--marca);
  color: #fff;
  border-color: var(--marca);
}
.horario-btn-detener.is-activo {
  background: var(--exito);
  border-color: var(--exito);
}
.horario-btn-pausa {
  background: var(--superficie);
  color: var(--tinta);
  border: 1.5px solid var(--aviso);
}
.horario-btn-pausa.is-activo {
  background: var(--aviso);
  color: #fff;
}
.horario-cabecera {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}
.horario-cabecera h3 {
  margin: 0;
  font-size: var(--fs-md);
}
.horario-copiar {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.schedule-day-row.is-cerrado {
  opacity: 0.6;
}
.schedule-day-row.is-cerrado .schedule-day-label::after {
  content: " · no abre";
  font-weight: 600;
  color: var(--marca-texto);
}
.horario-copiar .btn {
  min-height: 34px;
  padding: 6px 12px;
  font-size: var(--fs-xs);
}

/* --- Domiciliarios en tabla + filtros y paginación de cierres de turno --- */
.admin-drivers-table-wrap {
  margin: var(--sp-3) var(--sp-4);
}
.admin-table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--fs-sm);
}
.admin-table th {
  padding: var(--sp-2) var(--sp-3);
  text-align: left;
  font-size: var(--fs-xs);
  font-weight: 800;
  text-transform: uppercase;
  color: var(--color-text-muted);
  border-bottom: 1px solid var(--color-border);
}
.admin-table td {
  padding: var(--sp-3);
  vertical-align: middle;
  border-bottom: 1px solid var(--color-border);
}
.admin-driver-email {
  display: block;
  font-size: var(--fs-xs);
  color: var(--color-text-faint);
  word-break: break-all;
}
.admin-drivers-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--sp-2);
}
/* Celular: cada fila se apila como tarjeta, con la etiqueta de cada dato. */
@media (max-width: 719px) {
  .admin-drivers-table thead {
    display: none;
  }
  .admin-drivers-table,
  .admin-drivers-table tbody,
  .admin-drivers-table tr,
  .admin-drivers-table td {
    display: block;
  }
  .admin-drivers-table tr {
    margin-bottom: var(--sp-3);
    padding: var(--sp-2) var(--sp-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .admin-drivers-table td {
    padding: var(--sp-2) 0;
    border-bottom: 0;
  }
  .admin-drivers-table td[data-label]::before {
    content: attr(data-label);
    display: block;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
}
.admin-cash-filters {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: var(--sp-3);
  margin: 0 var(--sp-4) var(--sp-3);
}
.admin-cash-filters label {
  display: flex;
  flex-direction: column;
  gap: 2px;
  font-size: var(--fs-xs);
  color: var(--color-text-muted);
}
.admin-cash-filters input[type='date'] {
  padding: 6px 8px;
  font-size: var(--fs-sm);
  color: var(--color-text);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
}
.admin-cash-filters .admin-category-select {
  width: auto;
  min-width: 150px;
}
.admin-pager {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: var(--sp-3);
  margin: var(--sp-3) var(--sp-4);
  font-size: var(--fs-xs);
  color: var(--color-text-muted);
}
.admin-pager button {
  min-height: 36px;
  padding: 6px 14px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  color: var(--color-text);
  font-weight: 700;
}
.admin-pager button:disabled {
  opacity: 0.4;
}
